                 <property name="styleSheet">
                  <string notr="true">QPushButton {
    background-color: #1E88E5;   /* Blue */
    color: white;               /* White text */
    border: none;               /* No border line */
    border-radius: 10px;        /* Rounded corners */
    padding: 6px 20px;          /* Spacing inside */
    font-size: 16px;            /* Font size */
}

QPushButton:hover {
    background-color: #1565C0;  /* Darker blue on hover */
}

QPushButton:pressed {
    background-color: #0D47A1;  /* Darkest blue when pressed */
}
QPushButton:focus {
    outline: none;                 /* Remove dotted border */
    background-color: #074475;     /* Brighter blue highlight */
    border: 2px solid black;       /* White glow/border */
}</string>
                 </property>
                 <property name="text">
                  <string>Load</string>
