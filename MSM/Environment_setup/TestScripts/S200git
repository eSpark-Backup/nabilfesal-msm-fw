### BEGIN INIT INFO
# Provides:          git_update_reboot
# Required-Start:    $network $remote_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Pull latest updates from Git and reboot
### END INIT INFO

# Configuration
REPO_DIR="/MSM/potential-pancake"
BRANCH="Deployment"
CHECK_INTERVAL=60  # seconds

##script version 1.0.2

# Functions
check_and_update() {
    cd "$REPO_DIR" || return 1

    git checkout "$BRANCH" >/dev/null 2>&1 || return 1

    # Fetch latest changes
    git fetch origin "$BRANCH" >/dev/null 2>&1

    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/"$BRANCH")

    if [ "$LOCAL" != "$REMOTE" ]; then
        echo "$(date): New update found. Pulling changes..."
        git pull origin "$BRANCH"
        echo "$(date): Rebooting to apply updates..."

        chmod +x "$REPO_DIR/MSM/init-scripts/"*
        cp -f "$REPO_DIR/MSM/init-scripts/"* /etc/init.d/
        ##reboot
    else
        echo "$(date): No updates found."
    fi
}

# Main loop
(
while true; do
    check_and_update
    sleep "$CHECK_INTERVAL"
done
) &

exit 0
