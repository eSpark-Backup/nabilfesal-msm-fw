469:           void SendDataAsASCII(const uint8_t *data, size_t size, uint8_t index)
470:           {
471:               char hexBuffer[3]; // Temporary buffer for hex conversion
472:           
473:               for (size_t i = (size * index); i < (size * (index + 1)); i++)
474:               {
475:                   sprintf(hexBuffer, "%02X", data[i]);          // Convert byte to two hex characters
476:                   SERCOM2_USART_Write((uint8_t *)hexBuffer, 2); // Send the two hex characters
477:               }
478:           }
479:           
480:           void send_response_ct_ratio()
481:           {
482:               char buffer_2[600]; // Buffer for sending response of command ct_ratio
483:               for (int i = 0; i < 600; i++){
484:                   buffer_2[i] = '\0';
485:               }
486:               int count = snprintf(buffer_2, sizeof(buffer_2), 
487:                       "{"
488:                       "\"status\":true,"
489:                       "\"message\":\"Response\""
490:                       "}\n");
491:               
492:                if (count > 0 && count < sizeof(buffer_2)) {
493:                   SERCOM2_USART_Write((uint16_t *)buffer_2, count);
494:               }
495:           //}
496:           //    SERCOM2_USART_Write((uint8_t *)buffer, count);
497:           }
498:           
499:           void ConvertDataToHexAndSend(const uint8_t *data, size_t size)
500:           {
501:               char *ptr = txBuffer;
502:               for (size_t i = 0; i < size; i++)
503:               {
504:                   sprintf(ptr, "%02X", data[i]);
505:                   ptr += 2;
506:               }
507:               *ptr = '\0';
508:               SERCOM2_USART_Write((uint8_t *)txBuffer, ptr - txBuffer);
509:           }
510:           
511:           void ConvertDataToHexAndSend(const uint8_t *data, size_t size, uint8_t index)
512:           {
513:               char *ptr = txBuffer;
514:               for (size_t i = (size * (index - 1)); i < (size * index); i++)
515:               {
516:                   sprintf(ptr, "%02X", data[i]);
517:                   ptr += 2;
518:               }
519:               *ptr++ = '\n';
520:               *ptr = '\0';
521:               SERCOM2_USART_Write((uint8_t *)txBuffer, ptr - txBuffer);
522:           }
523:           
524:           // ??????ADE9000_status?????12????????
525:           void ConvertStatusToHexAndSend(void)
526:           {
527:               uint16_t statusBits = 0;
528:               for (int i = 0; i < TOTAL_ADE9000_UNITS; i++)
529:               {
530:                   statusBits |= (ADE9000_status[i] << (TOTAL_ADE9000_UNITS - 1 - i));
531:               }
532:               sprintf(txBuffer, "A5%03X\n", statusBits);
533:               SERCOM2_USART_Write((uint8_t *)txBuffer, strlen(txBuffer));
534:           }
535:           
536:           void USART_ReadCallback(uintptr_t context)
537:           {
538:               // Check for newline character
539:               if (rxBuffer[rxSize] == '\n')
540:               {
541:                   rxComplete = true;
542:               }
543:               else
544:               {
545:                   rxSize++;
546:                   if (rxSize < UART_RX_BUFFER_SIZE)
547:                   {
548:                       SERCOM2_USART_Read((void *)&rxBuffer[rxSize], 1);
549:                   }
550:               }
551:           }
