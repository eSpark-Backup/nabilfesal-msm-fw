179:           // *****************************************************************************
180:           // *****************************************************************************
181:           // Section: ADE9000 Initialize Functions
182:           // *****************************************************************************
183:           // *****************************************************************************
184:           
185:           bool IsADE9000(SPI_CSS_Pin css_pin)
186:           {
187:               uint32_t part_id = SPI_Read(ADDR_PART_ID, true, css_pin); // Assume SPI_Read reads 32-bit value
188:               printf("PART_ID Register: 0x%08lX\n", part_id);
189:           
190:               if (part_id == 0xffffffff)
191:                   return 0;
192:               // Check if bit 20 (ADE9000_ID) is set
193:               return (part_id & (1 << 20)) != 0;
194:           }
195:           
196:           void ADE9000_Initialize(SPI_CSS_Pin css_pin)
197:           {
198:               SPI_Write(ADDR_PGA_GAIN, ADE9000_PGA_GAIN, false, css_pin);
199:               SPI_Write(ADDR_CONFIG0, ADE9000_CONFIG0, true, css_pin);
200:               SPI_Write(ADDR_CONFIG1, ADE9000_CONFIG1, false, css_pin);
201:               SPI_Write(ADDR_CONFIG2, ADE9000_CONFIG2, false, css_pin);
202:               SPI_Write(ADDR_CONFIG3, ADE9000_CONFIG3, false, css_pin);
203:               SPI_Write(ADDR_ACCMODE, ADE9000_ACCMODE, false, css_pin);
204:               SPI_Write(ADDR_ZX_LP_SEL, ADE9000_ZX_LP_SEL, false, css_pin);
205:               SPI_Write(ADDR_MASK0, ADE9000_MASK0, true, css_pin);
206:               SPI_Write(ADDR_MASK1, ADE9000_MASK1, true, css_pin);
207:               SPI_Write(ADDR_EVENT_MASK, ADE9000_EVENT_MASK, true, css_pin);
208:               SPI_Write(ADDR_WFB_CFG, ADE9000_WFB_CFG, false, css_pin);
209:               SPI_Write(ADDR_VLEVEL, ADE9000_VLEVEL, true, css_pin);
210:               SPI_Write(ADDR_DICOEFF, ADE9000_DICOEFF, true, css_pin);
211:               SPI_Write(ADDR_EGY_TIME, ADE9000_EGY_TIME, false, css_pin);
212:               SPI_Write(ADDR_AVGAIN, 0x0131B28D, true, css_pin);
213:               SPI_Write(ADDR_BVGAIN, 0x0131CB92, true, css_pin);
214:               SPI_Write(ADDR_CVGAIN, 0x01321952, true, css_pin);
215:               SPI_Write(ADDR_AIGAIN, 0xF8BFCCA8, true, css_pin); // unit2
216:               SPI_Write(ADDR_BIGAIN, 0xF8BE351B, true, css_pin); // unit2
217:               SPI_Write(ADDR_CIGAIN, 0xF8950A51, true, css_pin); // unit2
218:               SPI_Write(ADDR_APGAIN, 0, true, css_pin);
219:               SPI_Write(ADDR_BPGAIN, 0, true, css_pin);
220:               SPI_Write(ADDR_CPGAIN, 0, true, css_pin);
221:               SPI_Write(ADDR_EP_CFG, ADE9000_EP_CFG, false, css_pin);
222:               SPI_Write(ADDR_RUN, ADE9000_RUN_ON, false, css_pin);
223:               SPI_Write(ADDR_TEMP_CFG, ADE9000_TEMP_CFG, false, css_pin);
224:           }
