583:           void extract_channel_values(const char* channel, uint16_t set_value){
584:               char *ch;
585:               if(strstr(rxBuffer, channel) != NULL){
586:                   ch = strstr(rxBuffer, channel);
587:                   ch = strchr(ch,':');
588:                   if(ch){
589:                       ch++;
590:                       while(*ch == ' ' || *ch == '\"') ch++;
591:                       char value[16];
592:                       int i = 0;
593:                       while(*ch && *ch != '\"' && *ch != ',' && *ch != ' '){
594:                           value[i++] = *ch++;
595:                       }
596:                       value[i] = '\0';
597:                       strcat(txBuffer, "\n");
598:                       strcat(txBuffer, channel);
599:                       strcat(txBuffer, " Value received: ");
600:                       strcat(txBuffer, value);
601:                       set_value = atoi(value); // atoi(ASCII TO Int) function is used to convert value from character to integer
602:                   }
603:               }
604:           }
605:           
606:           void parse_ct_ratio_json(){
607:               char *ch;
608:               ch = strstr(rxBuffer, "ct-ratio");
609:               if(ch != NULL){
610:                   strcpy(txBuffer,"");
611:                   char key[20];
612:                   for (int8_t j = 1; j < 13; j++){
613:                       sprintf(key, "channel-%d",j);
614:                       extract_channel_values(key,channelConfig[j].ctRatio);
615:                       ct_ratio_calibration(channelConfig[j].ctRatio);
616:                   }
617:                   strcat(txBuffer, "\nCT Ratio updated successfully!");
618:               }
619:           }
620:           
621:           
622:           void parse_i_offset_json(){
623:               char *ch;
624:               ch = strstr(rxBuffer, "i_offset");
625:               if(ch != NULL){
626:                   strcpy(txBuffer,"");
627:                   char key[20];
628:                   for (int8_t j = 1; j < 13; j++){
629:                       sprintf(key, "channel-%d",j);
630:                       extract_channel_values(key,channelConfig[j].setIOffset);
631:                       // use formula here for offset calibration
632:                   }
633:                   strcat(txBuffer, "\nCurrent Offset updated successfully!");
634:               }
635:           }
636:           
637:           
638:           void parse_v_offset_json(){
639:               char *ch;
640:               ch = strstr(rxBuffer, "v_offset");
641:               if(ch != NULL){
642:                   strcpy(txBuffer,"");
643:                   char key[20];
644:                   for (int8_t j = 1; j < 13; j++){
645:                       sprintf(key, "channel-%d",j);
646:                       extract_channel_values(key,channelConfig[j].setVOffset);
647:                       // use formula here for offset calibration
648:                   }
649:                   strcat(txBuffer, "\nVoltage Offset updated successfully!");
650:               }
651:           }
652:           
653:           
654:           void ProcessCommand(void)
655:           {
656:               rxBuffer[rxSize] = '\0';
657:               char *ch;
658:               
659:               
660:               if(rxBuffer[0] == '{' && rxBuffer[rxSize - 1] == '}'){ // check for JSON of calibration
661:                   ch = strstr(rxBuffer, "command");
662:                   if(ch != NULL){
663:                       ch = strchr(ch,':');
664:                       if(ch){
665:                           ch++;
666:                           while(*ch == ' ' || *ch == '\"') ch++;
667:                           char value[32];
668:                           int i = 0;
669:                           while(*ch && *ch != '\"'){
670:                               value[i++] = *ch++;
671:                           }
672:                           value[i] = '\0';
673:                           if(strcmp(value,"set-ct-ratio") == 0){
674:                               parse_ct_ratio_json();
675:                           }
676:                           else if(strcmp(value,"set-i-offset") == 0){
677:                               parse_i_offset_json();
678:                           }
679:                           else if(strcmp(value,"set-v-offset") == 0){
680:                               parse_v_offset_json();
681:                           }
682:                           else{
683:                               strcpy(txBuffer, "None Of The Three Calibration Parameter Values Found In JSON!");
684:                           }
685:                       }
686:                   }
687:                   else{
688:                       strcpy(txBuffer, "JSON does not contain command key!");
689:                   }
690:               }
691:               else if (strcmp(rxBuffer, "channel") == 0)
692:               {
693:                   for (size_t i = 1; i <= 12; i++)
694:                   {
695:                       sendChannelJsonData(i);
696:                   }
697:               }
698:               else if (strcmp(rxBuffer, "channel-1") == 0)
699:               {
700:                   sendChannelJsonData(1);
701:               }
702:               else if (strcmp(rxBuffer, "channel-2") == 0)
703:               {
704:                   sendChannelJsonData(2);
705:               }
706:               else if (strcmp(rxBuffer, "channel-3") == 0)
707:               {
708:                   sendChannelJsonData(3);
709:               }
710:               else if (strcmp(rxBuffer, "channel-4") == 0)
711:               {
712:                   sendChannelJsonData(4);
713:               }
714:               else if (strcmp(rxBuffer, "channel-5") == 0)
715:               {
716:                   sendChannelJsonData(5);
717:               }
718:               else if (strcmp(rxBuffer, "channel-6") == 0)
719:               {
720:                   sendChannelJsonData(6);
721:               }
722:               else if (strcmp(rxBuffer, "channel-7") == 0)
723:               {
724:                   sendChannelJsonData(7);
725:               }
726:               else if (strcmp(rxBuffer, "channel-8") == 0)
727:               {
728:                   sendChannelJsonData(8);
729:               }
730:               else if (strcmp(rxBuffer, "channel-9") == 0)
731:               {
732:                   sendChannelJsonData(9);
733:               }
734:               else if (strcmp(rxBuffer, "channel-10") == 0)
735:               {
736:                   sendChannelJsonData(10);
737:               }
738:               else if (strcmp(rxBuffer, "channel-11") == 0)
739:               {
740:                   sendChannelJsonData(11);
741:               }
742:               else if (strcmp(rxBuffer, "channel-12") == 0)
743:               {
744:                   sendChannelJsonData(12);
745:               }
746:               else if (strcmp(rxBuffer, "readstatus") == 0)
747:               {
748:                   ConvertStatusToHexAndSend();
749:               }
750:               else if (strcmp(rxBuffer, "ct-ratio") == 0)
751:               {
752:           //        strcpy(txBuffer, "Calibration 1: Step 1 settings");
753:                   strcpy(txBuffer, "CT Ratio updated successfully!");
754:                   
755:           //        ct_ratio_calibration(100);
756:           //        send_response_ct_ratio();
757:               }
758:               else if (strcmp(rxBuffer, "cal-2") == 0)
759:               {
760:                   strcpy(txBuffer, "Calibration 2: Step 2 settings");
761:               }
762:               else if (strcmp(rxBuffer, "cal-3") == 0)
763:               {
764:                   strcpy(txBuffer, "Calibration 3: Step 3 settings");
765:               }
766:               else if (strcmp(rxBuffer, "cal-4") == 0)
767:               {
768:                   strcpy(txBuffer, "Calibration 4: Step 4 settings");
769:               }
770:               else
771:               {
772:                   strcpy(txBuffer, "again");
773:               }
774:           
775:               strcat(txBuffer, "\n");
776:           
777:               SERCOM2_USART_Write(txBuffer, strlen(txBuffer));
778:           
779:               memset(rxBuffer, 0, UART_RX_BUFFER_SIZE);
780:               rxSize = 0;
781:               rxComplete = false;
782:           
783:               SERCOM2_USART_Read((void *)rxBuffer, 1);
784:           }
785:           
786:           void SetupUSART(void)
787:           {
788:               SERCOM2_USART_ReadCallbackRegister(USART_ReadCallback, 0);
789:               SERCOM2_USART_Read((void *)rxBuffer, 1);
790:           }
