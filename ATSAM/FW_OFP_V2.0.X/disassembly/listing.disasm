56:            
57:            
58:            /* SERCOM0 clk freq value for the baud calculation */
59:            #define SERCOM0_Frequency      (48000000UL)
60:            
61:            /* SERCOM0 SPI baud value for 1000000 Hz baud rate */
62:            #define SERCOM0_SPIM_BAUD_VALUE         (23UL)
63:            
64:            
65:            // *****************************************************************************
66:            // *****************************************************************************
67:            // Section: SERCOM0_SPI Implementation
68:            // *****************************************************************************
69:            // *****************************************************************************
