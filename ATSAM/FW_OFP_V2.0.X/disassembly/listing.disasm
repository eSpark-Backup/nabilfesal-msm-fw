71:            
72:            // *****************************************************************************
73:            /* Function:
74:                void SERCOM0_SPI_Initialize(void);
75:            
76:              Summary:
77:                Initializes instance SERCOM0 of the SERCOM module operating in SPI mode.
78:            
79:              Description:
80:                This function initializes instance SERCOM0 of SERCOM module operating in SPI mode.
81:                This function should be called before any other library function. The SERCOM
82:                module will be configured as per the MHC settings.
83:            
84:              Remarks:
85:                Refer plib_sercom0_spi.h file for more information.
86:            */
87:            
88:            void SERCOM0_SPI_Initialize(void)
89:            {
90:            
91:                /* Selection of the Character Size and Receiver Enable */
92:                SERCOM0_REGS->SPIM.SERCOM_CTRLB = SERCOM_SPIM_CTRLB_CHSIZE_8_BIT | SERCOM_SPIM_CTRLB_RXEN_Msk ;
93:            
94:                /* Wait for synchronization */
95:                while((SERCOM0_REGS->SPIM.SERCOM_STATUS & (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk) == (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk)
96:                {
97:                    /* Do nothing */
98:                }
99:            
100:               /* Selection of the Baud Value */
101:               SERCOM0_REGS->SPIM.SERCOM_BAUD = (uint8_t)SERCOM_SPIM_BAUD_BAUD(SERCOM0_SPIM_BAUD_VALUE);
102:           
103:               /* Configure Data Out Pin Out , Master Mode,
104:                * Data In and Pin Out,Data Order and Standby mode if configured
105:                * and Selection of the Clock Phase and Polarity and Enable the SPI Module
106:                */
107:               SERCOM0_REGS->SPIM.SERCOM_CTRLA = SERCOM_SPIM_CTRLA_MODE_SPI_MASTER | SERCOM_SPIM_CTRLA_DOPO_PAD0 | SERCOM_SPIM_CTRLA_DIPO_PAD3 | SERCOM_SPIM_CTRLA_CPOL_IDLE_HIGH | SERCOM_SPIM_CTRLA_CPHA_TRAILING_EDGE | SERCOM_SPIM_CTRLA_DORD_MSB | SERCOM_SPIM_CTRLA_ENABLE_Msk ;
108:           
109:           
110:               /* Wait for synchronization */
111:               while((SERCOM0_REGS->SPIM.SERCOM_STATUS & (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk) == (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk)
112:               {
113:                   /* Do nothing */
114:               }
115:           }
116:           
117:           // *****************************************************************************
118:           /* Function:
119:               bool SERCOM0_SPI_TransferSetup(SPI_TRANSFER_SETUP *setup,
120:                                                           uint32_t spiSourceClock);
121:           
122:            Summary:
123:               Configure SERCOM SPI operational parameters at run time.
124:           
125:             Description:
126:               This function allows the application to change the SERCOM SPI operational
127:               parameter at run time. The application can thus override the MHC defined
128:               configuration for these parameters. The parameter are specified via the
129:               SPI_TRANSFER_SETUP type setup parameter. Each member of this parameter
130:               should be initialized to the desired value.
131:           
132:               The application may feel need to call this function in situation where
133:               multiple SPI slaves, each with different operation parameters, are connected
134:               to one SPI master. This function can thus be used to setup the SPI Master to
135:               meet the communication needs of the slave.
136:           
137:               Calling this function will affect any ongoing communication. The application
138:               must thus ensure that there is no on-going communication on the SPI before
139:               calling this function.
140:           
141:             Remarks:
142:               Refer plib_sercom0_spi.h file for more information.
143:           */
144:           
145:           bool SERCOM0_SPI_TransferSetup(SPI_TRANSFER_SETUP *setup, uint32_t spiSourceClock)
146:           {
147:               uint32_t baudValue = 0U;
148:           
149:               bool statusValue = false;
150:           
151:               if(spiSourceClock == 0U)
152:               {
153:                   /* Fetch Master Clock Frequency directly */
154:                   spiSourceClock = SERCOM0_Frequency;
155:               }
156:           
157:               /* Disable the SPI Module */
158:               SERCOM0_REGS->SPIM.SERCOM_CTRLA &= ~(SERCOM_SPIM_CTRLA_ENABLE_Msk);
159:           
160:               /* Wait for synchronization */
161:               while((SERCOM0_REGS->SPIM.SERCOM_STATUS & (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk) == (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk)
162:               {
163:                   /* Do nothing */
164:               }
165:           
166:               if(setup != NULL)
167:               {
168:                   if (setup->clockFrequency <= spiSourceClock/2U)
169:                   {
170:                       baudValue = (spiSourceClock/(2U*(setup->clockFrequency))) - 1U;
171:           
172:                       /* Set the lowest possible baud */
173:                       if (baudValue >= 255U)
174:                       {
175:                           baudValue = 255U;
176:                       }
177:           
178:                       /* Selection of the Clock Polarity and Clock Phase */
179:                       SERCOM0_REGS->SPIM.SERCOM_CTRLA &= ~(SERCOM_SPIM_CTRLA_CPOL_Msk | SERCOM_SPIM_CTRLA_CPHA_Msk);
180:                       SERCOM0_REGS->SPIM.SERCOM_CTRLA |= (uint32_t)setup->clockPolarity | (uint32_t)setup->clockPhase;
181:           
182:                       /* Selection of the Baud Value */
183:                       SERCOM0_REGS->SPIM.SERCOM_BAUD = (uint8_t)baudValue;
184:           
185:                       /* Selection of the Character Size */
186:                       SERCOM0_REGS->SPIM.SERCOM_CTRLB &= ~SERCOM_SPIM_CTRLB_CHSIZE_Msk;
187:                       SERCOM0_REGS->SPIM.SERCOM_CTRLB |= (uint32_t)setup->dataBits;
188:           
189:                       /* Wait for synchronization */
190:                       while((SERCOM0_REGS->SPIM.SERCOM_STATUS & (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk) == (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk)
191:                       {
192:                           /* Do nothing */
193:                       }
194:           
195:                       statusValue = true;
196:                   }
197:               }
198:           
199:               /* Enabling the SPI Module */
200:               SERCOM0_REGS->SPIM.SERCOM_CTRLA |= SERCOM_SPIM_CTRLA_ENABLE_Msk;
201:           
202:               /* Wait for synchronization */
203:               while((SERCOM0_REGS->SPIM.SERCOM_STATUS & (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk) == (uint16_t)SERCOM_SPIM_STATUS_SYNCBUSY_Msk)
204:               {
205:                   /* Do nothing */
206:               }
207:           
208:               return statusValue;
209:           }
210:           
211:           
212:           
213:           bool SERCOM0_SPI_IsTransmitterBusy(void)
214:           {
215:               return ((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_TXC_Msk) == 0U)? true : false;
216:           }
217:           
218:           // *****************************************************************************
219:           /* Function:
220:               bool SERCOM0_SPI_WriteRead (void* pTransmitData, size_t txSize
221:                                                   void* pReceiveData, size_t rxSize);
222:           
223:             Summary:
224:               Write and Read data on SERCOM SERCOM0 SPI peripheral.
225:           
226:             Description:
227:               This function transmits "txSize" number of bytes and receives "rxSize"
228:               number of bytes on SERCOM SERCOM0 SPI module. Data pointed by pTransmitData is
229:               transmitted and received data is saved in the location pointed by
230:               pReceiveData. The function will transfer the maximum of "txSize" or "rxSize"
231:               data units towards completion.
232:           
233:               When "Interrupt Mode" option is unchecked in MHC, this function will be
234:               blocking in nature.  In this mode, the function will not return until all
235:               the requested data is transferred.  The function returns true after
236:               transferring all the data.  This indicates that the operation has been
237:               completed.
238:           
239:               When "Interrupt Mode" option is selected in MHC, the function will be
240:               non-blocking in nature.  The function returns immediately. The data transfer
241:               process continues in the peripheral interrupt.  The application specified
242:               transmit and receive buffer  are ownerd by the library until the data
243:               transfer is complete and should not be modified by the application till the
244:               transfer is complete.  Only one transfer is allowed at any time. The
245:               Application can use a callback function or a polling function to check for
246:               completion of the transfer. If a callback is required, this should be
247:               registered prior to calling the SERCOM0_SPI_WriteRead() function. The
248:               application can use the SERCOM0_SPI_IsBusy() to poll for completion.
249:           
250:             Remarks:
251:               Refer plib_sercom0_spi.h file for more information.
252:           */
253:           
254:           bool SERCOM0_SPI_WriteRead (void* pTransmitData, size_t txSize, void* pReceiveData, size_t rxSize)
255:           {
256:               size_t txCount = 0U;
257:               size_t rxCount = 0U;
258:               size_t dummySize = 0U;
259:               size_t receivedData;
260:               uint32_t dataBits;
261:               bool isSuccess = false;
262:           
263:               /* Verify the request */
264:               if(((txSize > 0U) && (pTransmitData != NULL)) || ((rxSize > 0U) && (pReceiveData != NULL)))
265:               {
266:                   dataBits = SERCOM0_REGS->SPIM.SERCOM_CTRLB & SERCOM_SPIM_CTRLB_CHSIZE_Msk;
267:           
268:                   if(dataBits != (uint32_t)SPI_DATA_BITS_8)
269:                   {
270:                       /* For 9-bit transmission, the txSize and rxSize must be an even number. */
271:                       if(((txSize > 0U) && ((txSize & 0x01U) != 0U)) || ((rxSize > 0U) && ((rxSize & 0x01U) != 0U)))
272:                       {
273:                           return isSuccess;
274:                       }
275:                   }
276:           
277:                   if(pTransmitData == NULL)
278:                   {
279:                       txSize = 0U;
280:                   }
281:           
282:                   if(pReceiveData == NULL)
283:                   {
284:                       rxSize = 0U;
285:                   }
286:           
287:                   /* Flush out any unread data in SPI DATA Register from the previous transfer */
288:                   while((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_RXC_Msk) == SERCOM_SPIM_INTFLAG_RXC_Msk)
289:                   {
290:                       receivedData = SERCOM0_REGS->SPIM.SERCOM_DATA;
291:                   }
292:           
293:                   SERCOM0_REGS->SPIM.SERCOM_STATUS |= (uint16_t)SERCOM_SPIM_STATUS_BUFOVF_Msk;
294:           
295:                   if(rxSize > txSize)
296:                   {
297:                       dummySize = rxSize - txSize;
298:                   }
299:           
300:                   if(dataBits != (uint32_t)SPI_DATA_BITS_8)
301:                   {
302:                       rxSize >>= 1U;
303:                       txSize >>= 1U;
304:                       dummySize >>= 1U;
305:                   }
306:           
307:                   /* Make sure DRE is empty */
308:                   while((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_DRE_Msk) != SERCOM_SPIM_INTFLAG_DRE_Msk)
309:                   {
310:                       /* Do nothing */
311:                   }
312:           
313:                   while((txCount != txSize) || (dummySize != 0U))
314:                   {
315:                       if(txCount != txSize)
316:                       {
317:                           if(dataBits == (uint32_t)SPI_DATA_BITS_8)
318:                           {
319:                               SERCOM0_REGS->SPIM.SERCOM_DATA = ((uint8_t*)pTransmitData)[txCount];
320:                               txCount++;
321:                           }
322:                           else
323:                           {
324:                               SERCOM0_REGS->SPIM.SERCOM_DATA = ((uint16_t*)pTransmitData)[txCount] & SERCOM_SPIM_DATA_Msk;
325:                               txCount++;
326:                           }
327:                       }
328:                       else if(dummySize > 0U)
329:                       {
330:                           if(dataBits == (uint32_t)SPI_DATA_BITS_8)
331:                           {
332:                               SERCOM0_REGS->SPIM.SERCOM_DATA = 0xFFU;
333:                           }
334:                           else
335:                           {
336:                               SERCOM0_REGS->SPIM.SERCOM_DATA = 0xFFFFU & SERCOM_SPIM_DATA_Msk;
337:                           }
338:           
339:                           dummySize--;
340:                       }
341:                       else
342:                       {
343:                           /* Do nothing */
344:                       }
345:           
346:                       if(rxSize == 0U)
347:                       {
348:                           /* For transmit only request, wait for DRE to become empty */
349:                           while((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_DRE_Msk) != SERCOM_SPIM_INTFLAG_DRE_Msk)
350:                           {
351:                               /* Do nothing */
352:                           }
353:                       }
354:                       else
355:                       {
356:                           /* If data is read, wait for the Receiver Data Register to become full */
357:                           while((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_RXC_Msk) != SERCOM_SPIM_INTFLAG_RXC_Msk)
358:                           {
359:                               /* Do nothing */
360:                           }
361:           
362:                           receivedData = SERCOM0_REGS->SPIM.SERCOM_DATA;
363:           
364:                           if(rxCount < rxSize)
365:                           {
366:                               if(dataBits == (uint32_t)SPI_DATA_BITS_8)
367:                               {
368:                                   ((uint8_t*)pReceiveData)[rxCount++] = (uint8_t)receivedData;
369:                               }
370:                               else
371:                               {
372:                                   ((uint16_t*)pReceiveData)[rxCount++] = (uint16_t)(receivedData & SERCOM_SPIM_DATA_Msk);
373:                               }
374:                           }
375:                       }
376:                   }
377:           
378:                   /* Make sure no data is pending in the shift register */
379:                   while((SERCOM0_REGS->SPIM.SERCOM_INTFLAG & SERCOM_SPIM_INTFLAG_TXC_Msk) != SERCOM_SPIM_INTFLAG_TXC_Msk)
380:                   {
381:                       /* Do nothing */
382:                   }
383:           
384:                   isSuccess = true;
385:               }
386:           
387:               return isSuccess;
388:           }
389:           
390:           bool SERCOM0_SPI_Write(void* pTransmitData, size_t txSize)
391:           {
392:               return SERCOM0_SPI_WriteRead(pTransmitData, txSize, NULL, 0U);
393:           }
394:           
395:           bool SERCOM0_SPI_Read(void* pReceiveData, size_t rxSize)
396:           {
397:               return SERCOM0_SPI_WriteRead(NULL, 0U, pReceiveData, rxSize);
398:           }
