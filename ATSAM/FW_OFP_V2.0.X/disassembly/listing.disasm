605:                   printf("VoltageTHDReg_A: %u, VoltageTHDValue_A: %.2f%%\n", tempReg, Data->VoltageTHDValue_A);
606:               }
607:           
608:               rawValue = SPI_Read(ADDR_BVTHD, true, css_pin);
609:               tempReg = *(int32_t *)&rawValue;
610:               Data->VoltageTHDReg_B = tempReg;
611:               Data->VoltageTHDValue_B = (float)tempReg * 100 / 134217728.0f;
612:               if (DEBUG)
613:               {
614:                   printf("VoltageTHDReg_B: %u, VoltageTHDValue_B: %.2f%%\n", tempReg, Data->VoltageTHDValue_B);
615:               }
616:           
617:               rawValue = SPI_Read(ADDR_CVTHD, true, css_pin);
618:               tempReg = *(int32_t *)&rawValue;
619:               Data->VoltageTHDReg_C = tempReg;
620:               Data->VoltageTHDValue_C = (float)tempReg * 100 / 134217728.0f;
621:               if (DEBUG)
622:               {
623:                   printf("VoltageTHDReg_C: %u, VoltageTHDValue_C: %.2f%%\n", tempReg, Data->VoltageTHDValue_C);
624:               }
625:           }
