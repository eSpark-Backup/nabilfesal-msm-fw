664:           
665:           void ReadAngleRegsnValues(AngleRegs *Data, SPI_CSS_Pin css_pin)
666:           {
667:               printf("Reading Angle Registers and Values...\n");
668:           
669:               uint32_t tempReg;
670:               uint16_t temp;
671:               float mulConstant;
672:               float tempValue;
673:           
674:               temp = SPI_Read(ADDR_ACCMODE, false, css_pin);
675:               printf("ACC MODE Register: %u\n", temp);
676:           
677:               if (temp & 0x0100)
678:               {
679:                   mulConstant = 0.02109375; // Multiplier constant for 60Hz system
680:                   printf("System Frequency: 60Hz, Multiplier Constant: %f\n", mulConstant);
681:               }
682:               else
683:               {
684:                   mulConstant = 0.017578125; // Multiplier constant for 50Hz system
685:                   printf("System Frequency: 50Hz, Multiplier Constant: %f\n", mulConstant);
686:               }
687:           
688:               tempReg = SPI_Read(ADDR_ANGL_VA_VB, true, css_pin);
689:               Data->AngleReg_VA_VB = tempReg;
690:               tempValue = tempReg * 0.017578125; // mulConstant
691:               Data->AngleValue_VA_VB = tempValue;
692:               printf("AngleReg_VA_VB: %u, AngleValue_VA_VB: %f\n", tempReg, tempValue);
693:           
694:               tempReg = SPI_Read(ADDR_ANGL_VB_VC, true, css_pin);
695:               Data->AngleReg_VB_VC = tempReg;
696:               tempValue = tempReg * 0.017578125; // mulConstant
697:               Data->AngleValue_VB_VC = tempValue;
698:               printf("AngleReg_VB_VC: %u, AngleValue_VB_VC: %f\n", tempReg, tempValue);
699:           
700:               tempReg = SPI_Read(ADDR_ANGL_VA_VC, true, css_pin);
701:               Data->AngleReg_VA_VC = tempReg;
702:               tempValue = tempReg * 0.017578125; // mulConstant
703:               Data->AngleValue_VA_VC = tempValue;
704:               printf("AngleReg_VA_VC: %u, AngleValue_VA_VC: %f\n", tempReg, tempValue);
705:           
706:               tempReg = int32_t(SPI_Read(ADDR_ANGL_VA_IA, true, css_pin));
707:               Data->AngleReg_VA_IA = tempReg;
708:               tempValue = tempReg * 0.017578125; // mulConstant
709:               Data->AngleValue_VA_IA = tempValue;
710:               printf("AngleValue_VA_IA: %u, AngleValue_VA_IA: %f\n", tempReg, tempValue);
711:           
712:               tempReg = int32_t(SPI_Read(ADDR_ANGL_VB_IB, true, css_pin));
713:               Data->AngleReg_VB_IB = tempReg;
714:               tempValue = tempReg * 0.017578125; // mulConstant
715:               Data->AngleValue_VB_IB = tempValue;
716:               printf("AngleValue_VB_IB: %u, AngleValue_VB_IB: %f\n", tempReg, tempValue);
717:           
718:               tempReg = int32_t(SPI_Read(ADDR_ANGL_VC_IC, true, css_pin));
719:               Data->AngleReg_VC_IC = tempReg;
720:               tempValue = tempReg * 0.017578125; // mulConstant
721:               Data->AngleValue_VC_IC = tempValue;
722:               printf("AngleValue_VC_IC: %u, AngleValue_VC_IC: %f\n", tempReg, tempValue);
723:           
724:               tempReg = int32_t(SPI_Read(ADDR_ANGL_IA_IB, true, css_pin));
725:               Data->AngleReg_IA_IB = tempReg;
726:               tempValue = tempReg * 0.017578125; // mulConstant
727:               Data->AngleValue_IA_IB = tempValue;
728:               printf("AngleValue_IA_IB: %u, AngleValue_IA_IB: %f\n", tempReg, tempValue);
729:           
730:               tempReg = int32_t(SPI_Read(ADDR_ANGL_IB_IC, true, css_pin));
731:               Data->AngleReg_IB_IC = tempReg;
732:               tempValue = tempReg * 0.017578125; // mulConstant
733:               Data->AngleValue_IB_IC = tempValue;
734:               printf("AngleValue_IB_IC: %u, AngleValue_IB_IC: %f\n", tempReg, tempValue);
735:           
736:               tempReg = int32_t(SPI_Read(ADDR_ANGL_IA_IC, true, css_pin));
737:               Data->AngleReg_IA_IC = tempReg;
738:               tempValue = tempReg * 0.017578125; // mulConstant
739:               Data->AngleValue_IA_IC = tempValue;
740:               printf("AngleValue_IA_IC: %u, AngleValue_IA_IC: %f\n", tempReg, tempValue);
741:           }
742:           
743:           /***************************TEMPERATURE VALUES*****************************/
744:           void ReadTempRegnValue(TemperatureRegs *Data, SPI_CSS_Pin css_pin)
745:           {
746:               uint32_t TEMP_CFG;
747:               uint32_t trim;
748:               uint16_t gain;
749:               uint16_t offset;
750:               uint16_t tempReg;
751:               float tempValue;
752:           
753:               trim = SPI_Read(ADDR_TEMP_TRIM, true, css_pin);
754:               gain = (trim & 0xFFFF);
755:               offset = ((trim >> 16) & 0xFFFF);
756:               //    printf("Read trim value: 0x%X, Gain: %d, Offset: %d\n", trim, gain, offset);
757:           
758:               tempReg = SPI_Read(ADDR_TEMP_RSLT, false, css_pin);
759:               //    printf("Read raw temperature register value: %d\n", tempReg);
760:           
761:               tempValue = (float)(offset >> 5) - ((float)tempReg * (float)gain / 65536.0f);
762:               //    printf("Calculated temperature value: %.2f\n", tempValue);
763:           
764:               Data->Temperature_Reg = tempReg;
765:               Data->Temperature = tempValue;
766:           }
767:           
768:           // *****************************************************************************
769:           // *****************************************************************************
770:           // Section: ADE9000 Calibration Functions
771:           // *****************************************************************************
772:           // *****************************************************************************
773:           
774:           void getPGA_gain(SPI_CSS_Pin css_pin, uint8_t *currentGain, uint8_t *voltageGain)
775:           {
776:               uint16_t pgaGainRegister;
777:           
778:               pgaGainRegister = SPI_Read(ADDR_PGA_GAIN, false, css_pin);
779:               uint8_t temp = pgaGainRegister & 0x0003;
780:               *currentGain = (temp == 0) ? 1 : (temp == 1) ? 2
781:                                                            : 4;
782:               temp = (pgaGainRegister >> 8) & 0x0003;
783:               *voltageGain = (temp == 0) ? 1 : (temp == 1) ? 2
784:                                                            : 4;
785:           }
786:           
787:           void ct_ratio_calibration(uint16_t ratio)
788:           {
789:               float current_transfer_func  = (float) R_BURDEN/ratio;
790:               
791:               calibration_data.cal_irms_cc = (SQRT_2 * current_transfer_func * ADE9000_RMS_FULL_SCALE_CODES);
792:               calibration_data.cal_power_cc = (2 * current_transfer_func * VOLTAGE_TRANSFER_FUNCTION * ADE9000_RMS_FULL_SCALE_CODES);
793:               calibration_data.cal_energy_cc = (2 * current_transfer_func * VOLTAGE_TRANSFER_FUNCTION * ADE9000_RMS_FULL_SCALE_CODES);
794:           }
795:           
796:           // float ct_ratio_calibration(uint16_t ratio)
797:           // {
798:           //     float current_transfer_func  = (float) R_BURDEN/ratio;
799:           // // CAL_IRMS_CC in uA/code = 10^6/(CURRENT_TRANSFER_FUNCTION*ADE9000_RMS_FULL_SCALE_CODES*SQRT(2)) 
800:           //     float cal_irms_cc = FULL_SCALE_VOLTAGE / (SQRT_2 * current_transfer_func * ADE9000_RMS_FULL_SCALE_CODES);
801:           //     return cal_irms_cc;
802:           // }
803:           
804:           // float ct_ratio_calibration(uint16_t ratio)
805:           // {
