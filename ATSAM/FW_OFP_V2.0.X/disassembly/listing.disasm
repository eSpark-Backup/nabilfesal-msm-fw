317:               storeIEEE754InBuffer(0, ADE9000_arrayBuffer, baseIndex + 153);
318:               storeIEEE754InBuffer(0, ADE9000_arrayBuffer, baseIndex + 157);
319:           
320:               uint16_t crcIndex = ((unitIndex - 1) * ARRAYSIZE_PER_UNIT) + ARRAYSIZE_PER_UNIT - 1;
321:               uint8_t crc = calculateCRC8(&ADE9000_arrayBuffer[(unitIndex - 1) * ARRAYSIZE_PER_UNIT], ARRAYSIZE_PER_UNIT - 1);
322:               ADE9000_arrayBuffer[crcIndex] = crc;
