83:            void delay_ms(uint32_t milliseconds)
84:            {
85:                TC0_TimerStart();
86:                for (uint32_t ms = 0; ms < milliseconds; ms++)
87:                {
88:                    TC0_Timer16bitCounterSet(0);
89:                    while (TC0_Timer16bitCounterGet() < 2000)
90:                    {
91:                    }
92:                }
93:                TC0_TimerStop();
94:            }
95:            
96:            void storeIEEE754InBuffer(float floatValue, uint8_t *buffer, uint16_t index)
97:            {
98:                if (index < 0 || index >= TOTAL_ARRAYSIZE - 4)
99:                {
100:                   return;
101:               }
102:               union
103:               {
104:                   float floatValue;
105:                   uint8_t bytes[4];
106:               } converter;
107:               converter.floatValue = floatValue;
108:               buffer[index] = converter.bytes[3];
109:               buffer[index + 1] = converter.bytes[2];
110:               buffer[index + 2] = converter.bytes[1];
111:               buffer[index + 3] = converter.bytes[0];
112:           }
113:           
114:           uint8_t calculateCRC8(const uint8_t *data, size_t len)
115:           {
116:               uint8_t crc = 0xFF; // Initial value
117:               for (size_t i = 0; i < len; ++i)
118:               {
119:                   crc ^= data[i];
120:                   for (uint8_t j = 0; j < 8; j++)
121:                   {
122:                       if (crc & 0x80)
123:                       {
124:                           crc = (crc << 1) ^ 0x31; // Polynomial 0x31 (Dallas/Maxim)
125:                       }
126:                       else
127:                       {
128:                           crc <<= 1;
129:                       }
130:                   }
131:               }
132:               return crc;
133:           }
