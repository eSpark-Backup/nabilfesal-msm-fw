231:           
232:           /***************************GENERAL VALUES*****************************/
233:           void ReadVoltageRMSRegs(VoltageRMSRegs *Data, SPI_CSS_Pin css_pin)
234:           {
235:               uint32_t rawValue;
236:               Data->VoltageRMSReg_A = int32_t(SPI_Read(ADDR_AVRMS, true, css_pin));
237:               Data->VoltageRMSReg_B = int32_t(SPI_Read(ADDR_BVRMS, true, css_pin));
238:               Data->VoltageRMSReg_C = int32_t(SPI_Read(ADDR_CVRMS, true, css_pin));
239:           
240:               if (css_pin)
241:               {
242:                   Data->VoltageRMSValue_A = (float)Data->VoltageRMSReg_A / (IC_CAL_VRMS_CC);
243:                   Data->VoltageRMSValue_B = (float)Data->VoltageRMSReg_B / (IC_CAL_VRMS_CC);
244:                   Data->VoltageRMSValue_C = (float)Data->VoltageRMSReg_C / (IC_CAL_VRMS_CC);
245:                   if (Data->VoltageRMSValue_A < NOMINAL_INPUT_VOLTAGE)
246:                   {
247:                       Data->VoltageRMSValue_A = 0.00f;
248:                   }
249:                   if (Data->VoltageRMSValue_B < NOMINAL_INPUT_VOLTAGE)
250:                   {
251:                       Data->VoltageRMSValue_B = 0.00f;
252:                   }
253:                   if (Data->VoltageRMSValue_C < NOMINAL_INPUT_VOLTAGE)
254:                   {
255:                       Data->VoltageRMSValue_C = 0.00f;
256:                   }
257:               }
258:           
259:               if (DEBUG)
260:               {
261:                   printf("Reading Voltage RMS Registers...\n");
262:                   printf("VoltageRMSReg_A: %d\n", Data->VoltageRMSReg_A);
263:                   printf("VoltageRMSReg_B: %d\n", Data->VoltageRMSReg_B);
264:                   printf("VoltageRMSReg_C: %d\n", Data->VoltageRMSReg_C);
265:                   printf("VoltageRMSValue_A: %.6f V, VoltageRMSValue_B: %.6f V, VoltageRMSValue_C: %.6f V\n",
266:                          Data->VoltageRMSValue_A, Data->VoltageRMSValue_B, Data->VoltageRMSValue_C);
267:               }
268:           }
269:           
270:           void ReadLineVoltages(VoltageRMSRegs *rmsData, LineVoltageRegs *lineData)
271:           {
272:               const float sqrt3 = sqrtf(3.0f);
273:           
274:               lineData->VoltageRMS_A = rmsData->VoltageRMSValue_A;
275:               lineData->VoltageRMS_B = rmsData->VoltageRMSValue_B;
276:               lineData->VoltageRMS_C = rmsData->VoltageRMSValue_C;
277:           
278:               lineData->LineVoltage_AB = lineData->VoltageRMS_A * sqrt3;
279:               lineData->LineVoltage_BC = lineData->VoltageRMS_B * sqrt3;
280:               lineData->LineVoltage_CA = lineData->VoltageRMS_C * sqrt3;
281:           
282:               if (DEBUG)
283:               {
284:                   printf("Calculating Line Voltages...\n");
285:                   printf("LineVoltage_AB: %.6f V, LineVoltage_BC: %.6f V, LineVoltage_CA: %.6f V\n",
286:                          lineData->LineVoltage_AB, lineData->LineVoltage_BC, lineData->LineVoltage_CA);
287:               }
288:           }
289:           
290:           void ReadCurrentRMSRegs(CurrentRMSRegs *Data, SPI_CSS_Pin css_pin)
291:           {
292:               uint32_t rawValue;
293:               Data->CurrentRMSReg_A = int32_t(SPI_Read(ADDR_AIRMS, true, css_pin));
294:               Data->CurrentRMSReg_B = int32_t(SPI_Read(ADDR_BIRMS, true, css_pin));
295:               Data->CurrentRMSReg_C = int32_t(SPI_Read(ADDR_CIRMS, true, css_pin));
296:           
297:               if (css_pin)
298:               {
299:                   Data->CurrentRMSValue_A = (float)Data->CurrentRMSReg_A / calibration_data.cal_irms_cc;
300:                   Data->CurrentRMSValue_B = (float)Data->CurrentRMSReg_B / calibration_data.cal_irms_cc;
301:                   Data->CurrentRMSValue_C = (float)Data->CurrentRMSReg_C / calibration_data.cal_irms_cc;
302:               }
303:           
304:               if (DEBUG)
305:               {
306:                   printf("Reading Current RMS Registers...\n");
307:                   printf("CurrentRMSReg_A: %d\n", Data->CurrentRMSReg_A);
308:                   printf("CurrentRMSReg_B: %d\n", Data->CurrentRMSReg_B);
309:                   printf("CurrentRMSReg_C: %d\n", Data->CurrentRMSReg_C);
310:                   printf("CurrentRMSValue_A: %.6f A, CurrentRMSValue_B: %.6f A, CurrentRMSValue_C: %.6f A\n",
311:                          Data->CurrentRMSValue_A, Data->CurrentRMSValue_B, Data->CurrentRMSValue_C);
312:               }
313:           }
314:           
315:           void ReadPeriodRegsnValues(PeriodRegs *Data, VoltageRMSRegs *RMSData, SPI_CSS_Pin css_pin)
316:           {
317:               if (DEBUG)
318:               {
319:                   printf("Reading Period Registers and Calculating Frequencies...\n");
320:               }
321:               uint32_t tempReg;
322:           
323:               if (RMSData->VoltageRMSValue_A)
324:               {
325:                   tempReg = SPI_Read(ADDR_APERIOD, true, css_pin);
326:                   Data->PeriodReg_A = tempReg;
327:                   Data->FrequencyValue_A = (float)(8000 * 65536) / (tempReg + 1);
328:                   if (DEBUG)
329:                   {
330:                       printf("PeriodReg_A: %u, FrequencyValue_A: %.2f Hz\n", tempReg, Data->FrequencyValue_A);
331:                   }
332:               }
333:           
334:               if (RMSData->VoltageRMSValue_B)
335:               {
336:                   tempReg = SPI_Read(ADDR_BPERIOD, true, css_pin);
337:                   Data->PeriodReg_B = tempReg;
338:                   Data->FrequencyValue_B = (float)(8000 * 65536) / (tempReg + 1);
339:                   if (DEBUG)
340:                   {
341:                       printf("PeriodReg_B: %u, FrequencyValue_B: %.2f Hz\n", tempReg, Data->FrequencyValue_B);
342:                   }
343:               }
344:           
345:               if (RMSData->VoltageRMSValue_C)
346:               {
347:                   tempReg = SPI_Read(ADDR_CPERIOD, true, css_pin);
348:                   Data->PeriodReg_C = tempReg;
349:                   Data->FrequencyValue_C = (float)(8000 * 65536) / (tempReg + 1);
350:                   if (DEBUG)
351:                   {
352:                       printf("PeriodReg_C: %u, FrequencyValue_C: %.2f Hz\n", tempReg, Data->FrequencyValue_C);
353:                   }
354:               }
355:           }
356:           
357:           /***************************POWER VALUES*****************************/
358:           void ReadActivePowerRegs(ActivePowerRegs *Data, SPI_CSS_Pin css_pin)
359:           {
360:               uint32_t rawValue;
361:               Data->ActivePowerReg_A = int32_t(SPI_Read(ADDR_AWATT, true, css_pin));
362:               Data->ActivePowerReg_B = int32_t(SPI_Read(ADDR_BWATT, true, css_pin));
363:               Data->ActivePowerReg_C = int32_t(SPI_Read(ADDR_CWATT, true, css_pin));
364:               if (css_pin)
365:               {
366:                   Data->ActivePowerValue_A = (float)Data->ActivePowerReg_A / (calibration_data.cal_power_cc * 1000.0f);
367:                   Data->ActivePowerValue_B = (float)Data->ActivePowerReg_B / (calibration_data.cal_power_cc * 1000.0f);
368:                   Data->ActivePowerValue_C = (float)Data->ActivePowerReg_C / (calibration_data.cal_power_cc * 1000.0f);
369:               }
370:           
371:               if (DEBUG)
372:               {
373:                   printf("Reading Active Power Registers...\n");
374:                   printf("ActivePowerReg_A: 0x%X, ", Data->ActivePowerReg_A);
375:                   printf("ActivePowerReg_B: 0x%X, ", Data->ActivePowerReg_B);
376:                   printf("ActivePowerReg_C: 0x%X\n", Data->ActivePowerReg_C);
377:                   printf("ActivePowerValue_A: %.3f kW, ActivePowerValue_B: %.3f kW, ActivePowerValue_C: %.3f kW\n",
378:                          Data->ActivePowerValue_A, Data->ActivePowerValue_B, Data->ActivePowerValue_C);
379:               }
380:           }
381:           
382:           void ReadReactivePowerRegs(ReactivePowerRegs *Data1, ApparentPowerRegs *Data2, PowerFactorRegs *Data3, SPI_CSS_Pin css_pin)
383:           {
384:               Data1->ReactivePowerReg_A = int32_t(SPI_Read(ADDR_AVAR, true, css_pin));
385:               Data1->ReactivePowerReg_B = int32_t(SPI_Read(ADDR_BVAR, true, css_pin));
386:               Data1->ReactivePowerReg_C = int32_t(SPI_Read(ADDR_CVAR, true, css_pin));
387:           
388:               float RPV1_sign = (float)Data1->ReactivePowerReg_A / calibration_data.cal_power_cc;
389:               float RPV2_sign = (float)Data1->ReactivePowerReg_B / calibration_data.cal_power_cc;
390:               float RPV3_sign = (float)Data1->ReactivePowerReg_C / calibration_data.cal_power_cc;
391:           
392:               float phaseAngle1 = acosf(Data3->PowerFactorValue_A);
393:               float phaseAngle2 = acosf(Data3->PowerFactorValue_B);
394:               float phaseAngle3 = acosf(Data3->PowerFactorValue_C);
395:           
396:               Data1->ReactivePowerValue_A = (Data2->ApparentPowerValue_A * sin(phaseAngle1)) * (RPV1_sign < 0 ? -1 : 1);
397:               Data1->ReactivePowerValue_B = (Data2->ApparentPowerValue_B * sin(phaseAngle2)) * (RPV2_sign < 0 ? -1 : 1);
398:               Data1->ReactivePowerValue_C = (Data2->ApparentPowerValue_C * sin(phaseAngle3)) * (RPV3_sign < 0 ? -1 : 1);
399:           
400:               printf("Reactive Power Values: A: %f, B: %f, C: %f\n", Data1->ReactivePowerValue_A, Data1->ReactivePowerValue_B, Data1->ReactivePowerValue_C);
401:           }
402:           
403:           void ReadApparentPowerRegs(ApparentPowerRegs *Data, SPI_CSS_Pin css_pin)
404:           {
405:               uint32_t rawValue;
406:               Data->ApparentPowerReg_A = int32_t(SPI_Read(ADDR_AVA, true, css_pin));
407:               Data->ApparentPowerReg_B = int32_t(SPI_Read(ADDR_BVA, true, css_pin));
408:               Data->ApparentPowerReg_C = int32_t(SPI_Read(ADDR_CVA, true, css_pin));
409:               if (css_pin)
410:               {
411:                   Data->ApparentPowerValue_A = (float)Data->ApparentPowerReg_A / calibration_data.cal_irms_cc;
412:                   Data->ApparentPowerValue_B = (float)Data->ApparentPowerReg_B / calibration_data.cal_irms_cc;
413:                   Data->ApparentPowerValue_C = (float)Data->ApparentPowerReg_C / calibration_data.cal_irms_cc;
414:               }
415:           
416:               if (DEBUG)
417:               {
418:                   printf("Reading Apparent Power Registers...\n");
419:                   printf("ApparentPowerReg_A: 0x%X, ", Data->ApparentPowerReg_A);
420:                   printf("ApparentPowerReg_B: 0x%X, ", Data->ApparentPowerReg_B);
421:                   printf("ApparentPowerReg_C: 0x%X\n", Data->ApparentPowerReg_C);
422:                   printf("ApparentPowerValue_A: %.3f kVA, ApparentPowerValue_B: %.3f kVA, ApparentPowerValue_C: %.3f kVA\n",
423:                          Data->ApparentPowerValue_A, Data->ApparentPowerValue_B, Data->ApparentPowerValue_C);
424:               }
425:           }
426:           
427:           void ReadPowerFactorRegsnValues(PowerFactorRegs *Data, VoltageRMSRegs *rmsData, CurrentRMSRegs *currentData, SPI_CSS_Pin css_pin)
428:           {
429:               if (DEBUG)
430:               {
431:                   printf("Reading Power Factor Registers and Values...\n");
432:               }
433:           
434:               uint32_t rawValue;
435:               int32_t tempReg;
436:           
437:               if (rmsData->VoltageRMSValue_A > NOMINAL_INPUT_VOLTAGE && currentData->CurrentRMSValue_A > 0.1)
438:               {
439:                   rawValue = SPI_Read(ADDR_APF, true, css_pin);
440:                   tempReg = *(int32_t *)&rawValue;
441:                   Data->PowerFactorReg_A = tempReg;
442:                   Data->PowerFactorValue_A = (float)tempReg / 134217728.0f;
443:                   if (DEBUG)
444:                   {
445:                       printf("PowerFactorReg_A: %u, PowerFactorValue_A: %.2f\n", tempReg, Data->PowerFactorValue_A);
446:                   }
447:               }
448:               else
449:               {
450:                   Data->PowerFactorValue_A = 1.0f;
451:               }
452:           
453:               if (rmsData->VoltageRMSValue_B > NOMINAL_INPUT_VOLTAGE && currentData->CurrentRMSValue_B > 0.1)
454:               {
455:                   rawValue = SPI_Read(ADDR_BPF, true, css_pin);
456:                   tempReg = *(int32_t *)&rawValue;
457:                   Data->PowerFactorReg_B = tempReg;
458:                   Data->PowerFactorValue_B = (float)tempReg / 134217728.0f;
459:                   if (DEBUG)
460:                   {
461:                       printf("PowerFactorReg_B: %u, PowerFactorValue_B: %.2f\n", tempReg, Data->PowerFactorValue_B);
462:                   }
463:               }
464:               else
465:               {
466:                   Data->PowerFactorValue_B = 1.0f;
467:               }
468:           
469:               if (rmsData->VoltageRMSValue_C > NOMINAL_INPUT_VOLTAGE && currentData->CurrentRMSValue_C > 0.1)
470:               {
471:                   rawValue = SPI_Read(ADDR_CPF, true, css_pin);
472:                   tempReg = *(int32_t *)&rawValue;
473:                   Data->PowerFactorReg_C = tempReg;
474:                   Data->PowerFactorValue_C = (float)tempReg / 134217728.0f;
475:                   if (DEBUG)
476:                   {
477:                       printf("PowerFactorReg_C: %u, PowerFactorValue_C: %.2f\n", tempReg, Data->PowerFactorValue_C);
478:                   }
479:               }
480:               else
481:               {
482:                   Data->PowerFactorValue_C = 1.0f;
483:               }
484:           }
485:           
486:           /***************************ENERGY VALUES*****************************/
487:           void ReadEnergyRegs(EnergyRegs *Data1, ActivePowerRegs *Data2, SPI_CSS_Pin css_pin)
488:           {
489:               static uint8_t discardInitialReadingsCount = 0;
490:               const uint8_t INITIAL_READINGS_TO_DISCARD = 10;
491:               uint32_t status0;
492:               uint32_t rawValue;
493:               status0 = SPI_Read(ADDR_STATUS0, true, css_pin);
494:           
495:               if (status0 & 0x01)
496:               {
497:                   if (discardInitialReadingsCount < INITIAL_READINGS_TO_DISCARD)
498:                   {
499:                       discardInitialReadingsCount++;
500:                       return;
501:                   }
502:                   if (SECONDHEX)
503:                   {
504:                       rawValue = SPI_Read(ADDR_AFWATTHR_HI, true, css_pin);
505:                       Data1->ActiveEnergyReg_A = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
506:                       rawValue = SPI_Read(ADDR_BFWATTHR_HI, true, css_pin);
507:                       Data1->ActiveEnergyReg_B = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
508:                       rawValue = SPI_Read(ADDR_CFWATTHR_HI, true, css_pin);
509:                       Data1->ActiveEnergyReg_C = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
510:                       rawValue = SPI_Read(ADDR_AFVARHR_HI, true, css_pin);
511:                       Data1->ReactiveEnergyReg_A = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
512:                       rawValue = SPI_Read(ADDR_BFVARHR_HI, true, css_pin);
513:                       Data1->ReactiveEnergyReg_B = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
514:                       rawValue = SPI_Read(ADDR_CFVARHR_HI, true, css_pin);
515:                       Data1->ReactiveEnergyReg_C = (rawValue & 0x80000000) ? -((int32_t)(~rawValue + 1)) : (int32_t)rawValue;
516:                   }
517:                   else
518:                   {
519:                       Data1->ActiveEnergyReg_A = SPI_Read(ADDR_AFWATTHR_HI, true, css_pin);
520:                       Data1->ActiveEnergyReg_B = SPI_Read(ADDR_BFWATTHR_HI, true, css_pin);
521:                       Data1->ActiveEnergyReg_C = SPI_Read(ADDR_CFWATTHR_HI, true, css_pin);
522:                       Data1->ReactiveEnergyReg_A = SPI_Read(ADDR_AFVARHR_HI, true, css_pin);
523:                       Data1->ReactiveEnergyReg_B = SPI_Read(ADDR_BFVARHR_HI, true, css_pin);
524:                       Data1->ReactiveEnergyReg_C = SPI_Read(ADDR_CFVARHR_HI, true, css_pin);
525:                   }
526:           
527:                   // Data1->ActiveEnergyValue_kWh_A = Data1->ActiveEnergyReg_A * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
528:                   // Data1->ActiveEnergyValue_kWh_B = Data1->ActiveEnergyReg_B * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
529:                   // Data1->ActiveEnergyValue_kWh_C = Data1->ActiveEnergyReg_C * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
530:                   // Data1->ReactiveEnergyValue_kWh_A = Data1->ReactiveEnergyReg_A * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
531:                   // Data1->ReactiveEnergyValue_kWh_B = Data1->ReactiveEnergyReg_B * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
532:                   // Data1->ReactiveEnergyValue_kWh_C = Data1->ReactiveEnergyReg_C * (float) (CAL_ENERGY_CC * 8000 * 3600) / 1000000 / 1000;
533:           
534:                   const float timeFactor = 1.0 / 3600.0;
535:                   if (Data2->ActivePowerValue_A < 0)
536:                   {
537:                       Data1->NActiveEnergyValue_kWh_A = Data2->ActivePowerValue_A * timeFactor;
538:                       Data1->PActiveEnergyValue_kWh_A = 0;
539:                   }
540:                   else
541:                   {
542:                       Data1->PActiveEnergyValue_kWh_A = Data2->ActivePowerValue_A * timeFactor;
543:                       Data1->NActiveEnergyValue_kWh_A = 0;
544:                   }
545:                   if (Data2->ActivePowerValue_B < 0)
546:                   {
547:                       Data1->NActiveEnergyValue_kWh_B = Data2->ActivePowerValue_B * timeFactor;
548:                       Data1->PActiveEnergyValue_kWh_B = 0;
549:                   }
550:                   else
551:                   {
552:                       Data1->PActiveEnergyValue_kWh_B = Data2->ActivePowerValue_B * timeFactor;
553:                       Data1->NActiveEnergyValue_kWh_B = 0;
554:                   }
555:                   if (Data2->ActivePowerValue_C < 0)
556:                   {
557:                       Data1->NActiveEnergyValue_kWh_C = Data2->ActivePowerValue_C * timeFactor;
558:                       Data1->PActiveEnergyValue_kWh_C = 0;
559:                   }
560:                   else
561:                   {
562:                       Data1->PActiveEnergyValue_kWh_C = Data2->ActivePowerValue_C * timeFactor;
563:                       Data1->NActiveEnergyValue_kWh_C = 0;
564:                   }
565:           
566:                   SPI_Write(ADDR_STATUS0, (status0 | 0x01), true, css_pin);
567:               }
568:               else
569:               {
570:                   Data1->ActiveEnergyReg_A = 0;
571:                   Data1->ActiveEnergyReg_B = 0;
572:                   Data1->ActiveEnergyReg_C = 0;
573:                   Data1->PActiveEnergyValue_kWh_A = 0;
574:                   Data1->PActiveEnergyValue_kWh_B = 0;
575:                   Data1->PActiveEnergyValue_kWh_C = 0;
576:                   Data1->NActiveEnergyValue_kWh_A = 0;
577:                   Data1->NActiveEnergyValue_kWh_B = 0;
578:                   Data1->NActiveEnergyValue_kWh_C = 0;
579:           
580:                   Data1->ReactiveEnergyReg_A = 0;
581:                   Data1->ReactiveEnergyReg_B = 0;
582:                   Data1->ReactiveEnergyReg_C = 0;
583:                   Data1->ReactiveEnergyValue_kWh_A = 0;
584:                   Data1->ReactiveEnergyValue_kWh_B = 0;
585:                   Data1->ReactiveEnergyValue_kWh_C = 0;
586:               }
587:           }
