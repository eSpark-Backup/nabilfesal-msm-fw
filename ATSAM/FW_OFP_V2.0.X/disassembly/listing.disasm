554:           {
555:               for (int i = 0; i < TOTAL_ADE9000_UNITS; i++)
556:               {
557:                   unitMeasurements[i].activeEnergy.ACC_NActiveEnergyValue_kWh_A = 0;
558:                   unitMeasurements[i].activeEnergy.ACC_NActiveEnergyValue_kWh_B = 0;
559:                   unitMeasurements[i].activeEnergy.ACC_NActiveEnergyValue_kWh_C = 0;
560:                   unitMeasurements[i].activeEnergy.ACC_PActiveEnergyValue_kWh_A = 0;
561:                   unitMeasurements[i].activeEnergy.ACC_PActiveEnergyValue_kWh_B = 0;
562:                   unitMeasurements[i].activeEnergy.ACC_PActiveEnergyValue_kWh_C = 0;
563:               }
564:           }
