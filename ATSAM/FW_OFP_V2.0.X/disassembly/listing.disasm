339:           void LED_Clear(int ledIndex)
340:           {
341:               switch (ledIndex)
342:               {
343:               case 1:
344:                   LED_STATUS1_Set();
345:                   break;
346:               case 2:
347:                   LED_STATUS2_Set();
348:                   break;
349:               case 3:
350:                   LED_STATUS3_Set();
351:                   break;
352:               case 4:
353:                   LED_STATUS4_Set();
354:                   break;
355:               }
356:           }
357:           
358:           void LED_Set(int ledIndex)
359:           {
360:               switch (ledIndex)
361:               {
362:               case 1:
363:                   LED_STATUS1_Clear();
364:                   break;
365:               case 2:
366:                   LED_STATUS2_Clear();
367:                   break;
368:               case 3:
369:                   LED_STATUS3_Clear();
370:                   break;
371:               case 4:
372:                   LED_STATUS4_Clear();
373:                   break;
374:               }
375:           }
376:           
377:           void setLEDStatus(int ledIndex, int statusIndex)
378:           {
379:               if (ADE9000_status[statusIndex] == 1 && ADE9000_status[statusIndex + 1] == 1 && ADE9000_status[statusIndex + 2] == 1)
380:               {
381:                   LED_Set(ledIndex);
382:               }
383:               else
384:               {
385:                   LED_Clear(ledIndex);
386:               }
387:           }
388:           
389:           void ADE9000Status_Check()
390:           {
391:               for (int i = 0; i < 12; i += 3)
392:               {
393:                   setLEDStatus(i / 3 + 1, i);
394:               }
395:           }
396:           
397:           void ADE9000SetupForUnit(SPI_CSS_Pin cssPin)
398:           {
399:               if (IsADE9000(cssPin))
400:               {
401:                   // printf("ADE9000 Setup Successful\n");
402:                   ADE9000_status[cssPin - 1] = 1;
403:                   ADE9000_hotplug[cssPin - 1] = 1;
404:                   ADE9000_Initialize(cssPin); 
405:               }
406:               else
407:               {
408:                   // printf("ADE9000 Setup Failed\n");
409:                   ADE9000_status[cssPin - 1] = 0;
410:                   ADE9000_hotplug[cssPin - 1] = 0;
411:               }
412:           }
