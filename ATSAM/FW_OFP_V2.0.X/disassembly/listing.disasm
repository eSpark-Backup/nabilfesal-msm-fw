206:                           "},"
207:                           "\"threshold\":{"
208:                               "\"current\":%.2f,"
209:                               "\"voltage\":%.2f,"
210:                               "\"angle\":%.2f"
211:                           "}"
212:                       "}%s",
213:                       phases[i],
214:                       lineVoltage[i], rmsVoltage[i], frequency[i], current[i],
215:                       powerFactor[i], activePower[i], reactivePower[i], apparentPower[i],
216:                       posEnergy[i], negEnergy[i],
217:                       currentTHD[i], voltageTHD[i], angle[i],
218:                       (i < 2) ? "," : "" // Comma between objects, not after last one
219:                   );
220:                   ptr += written;
221:                   remaining -= written;
222:               }
223:           
224:               // Close outer JSON objects
225:               written = snprintf(ptr, remaining, "}}\n");
226:               ptr += written;
227:           
228:               // Send over UART (SERCOM2)
229:               SERCOM2_USART_Write((uint8_t *)jsonBuffer, ptr - jsonBuffer);
230:           }
231:           
232:           void ADE9000MeasurementsForUnit(SPI_CSS_Pin cssPin, uint8_t unitIndex)
233:           {
234:               uint16_t baseIndex = (unitIndex - 1) * ARRAYSIZE_PER_UNIT;
235:               ADE9000_arrayBuffer[baseIndex] = 0xAA + (unitIndex - 1);
236:           
237:               ReadVoltageRMSRegs(&unitMeasurements[unitIndex - 1].voltageRMS, cssPin);
238:               ReadLineVoltages(&unitMeasurements[unitIndex - 1].voltageRMS, &unitMeasurements[cssPin - 1].lineVoltage);
239:               ReadCurrentRMSRegs(&unitMeasurements[unitIndex - 1].currentRMS, cssPin);
240:               ReadPeriodRegsnValues(&unitMeasurements[unitIndex - 1].periodFrequency, &unitMeasurements[unitIndex - 1].voltageRMS, cssPin);
241:               
242:               ReadActivePowerRegs(&unitMeasurements[unitIndex - 1].activePower, cssPin);
243:               ReadReactivePowerRegs(&unitMeasurements[unitIndex - 1].reactivePower,&unitMeasurements[unitIndex - 1].apparentPower,&unitMeasurements[unitIndex - 1].powerFactor, cssPin);
244:               ReadApparentPowerRegs(&unitMeasurements[unitIndex - 1].apparentPower, cssPin);
245:               ReadPowerFactorRegsnValues(&unitMeasurements[unitIndex - 1].powerFactor, &unitMeasurements[unitIndex - 1].voltageRMS, &unitMeasurements[unitIndex - 1].currentRMS, cssPin);
246:               
247:               ReadEnergyRegs(&unitMeasurements[unitIndex - 1].activeEnergy,&unitMeasurements[unitIndex - 1].activePower, cssPin);
248:               
249:               ReadVoltageTHDRegsnValues(&unitMeasurements[unitIndex - 1].voltageTHD, cssPin);
250:               ReadCurrentTHDRegsnValues(&unitMeasurements[unitIndex - 1].currentTHD, cssPin);
251:               ReadAngleRegsnValues(&unitMeasurements[unitIndex - 1].angleDegree, cssPin);
252:               
253:               ReadTempRegnValue(&unitMeasurements[unitIndex - 1].temperature, cssPin);
254:               
255:               uint16_t crcIndex = ((unitIndex - 1) * ARRAYSIZE_PER_UNIT) + ARRAYSIZE_PER_UNIT - 1;
256:               uint8_t crc = calculateCRC8(&ADE9000_arrayBuffer[(unitIndex - 1) * ARRAYSIZE_PER_UNIT], ARRAYSIZE_PER_UNIT - 1);
257:               ADE9000_arrayBuffer[crcIndex] = crc;
258:           }
