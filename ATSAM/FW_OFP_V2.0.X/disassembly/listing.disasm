14:            // *****************************************************************************
15:            // *****************************************************************************
16:            // Section: ADE9000 SPI Functions
17:            // *****************************************************************************
18:            // *****************************************************************************
19:            
20:            void SPI_CSS_Control(SPI_CSS_Pin pin, bool set)
21:            {
22:                switch (pin)
23:                {
24:                case SPI_CSS1:
25:                    set ? SPI_CSS1_Set() : SPI_CSS1_Clear();
26:                    break;
27:                case SPI_CSS2:
28:                    set ? SPI_CSS2_Set() : SPI_CSS2_Clear();
29:                    break;
30:                case SPI_CSS3:
31:                    set ? SPI_CSS3_Set() : SPI_CSS3_Clear();
32:                    break;
33:                case SPI_CSS4:
34:                    set ? SPI_CSS4_Set() : SPI_CSS4_Clear();
35:                    break;
36:                case SPI_CSS5:
37:                    set ? SPI_CSS5_Set() : SPI_CSS5_Clear();
38:                    break;
39:                case SPI_CSS6:
40:                    set ? SPI_CSS6_Set() : SPI_CSS6_Clear();
41:                    break;
42:                case SPI_CSS7:
43:                    set ? SPI_CSS7_Set() : SPI_CSS7_Clear();
44:                    break;
45:                case SPI_CSS8:
46:                    set ? SPI_CSS8_Set() : SPI_CSS8_Clear();
47:                    break;
48:                case SPI_CSS9:
49:                    set ? SPI_CSS9_Set() : SPI_CSS9_Clear();
50:                    break;
51:                case SPI_CSS10:
52:                    set ? SPI_CSS10_Set() : SPI_CSS10_Clear();
53:                    break;
54:                case SPI_CSS11:
55:                    set ? SPI_CSS11_Set() : SPI_CSS11_Clear();
56:                    break;
57:                case SPI_CSS12:
58:                    set ? SPI_CSS12_Set() : SPI_CSS12_Clear();
59:                    break;
60:                default:
61:                    break;
62:                }
63:            }
64:            
65:            void SPI_Write(uint16_t address, uint32_t data, bool is32Bit, SPI_CSS_Pin css_pin)
66:            {
67:                char debugMsg[128]; // Buffer for debug messages
68:                uint16_t cmd_hdr = (address << 4) & 0xFFF0;
69:                uint8_t addressHigh = (cmd_hdr >> 8) & 0xFF;
70:                uint8_t addressLow = cmd_hdr & 0xFF;
71:            
72:                if (DEBUG)
73:                {
74:                    sprintf(debugMsg, "SPI_Write: Start, Address=0x%04X, Data=0x%08X, is32Bit=%d", cmd_hdr, data, is32Bit);
75:                    printf("%s\n", debugMsg);
76:                }
77:            
78:                SPI_CSS_Control(css_pin, false);
79:            
80:                if (DEBUG)
81:                {
82:                    sprintf(debugMsg, "SPI_Write: CSS Pin=%d set to LOW", css_pin);
83:                    printf("%s\n", debugMsg);
84:                }
85:            
86:                SERCOM0_SPI_Write(&addressHigh, 1);
87:                SERCOM0_SPI_Write(&addressLow, 1);
88:                if (DEBUG)
89:                {
90:                    sprintf(debugMsg, "SPI_Write: Address sent (High=0x%02X, Low=0x%02X)", addressHigh, addressLow);
91:                    printf("%s\n", debugMsg);
92:                }
93:            
94:                if (is32Bit)
95:                {
96:                    for (int i = 3; i >= 0; i--)
97:                    {
98:                        uint8_t dataChunk = (data >> (i * 8)) & 0xFF;
99:                        SERCOM0_SPI_Write(&dataChunk, 1);
100:                       if (DEBUG)
101:                       {
102:                           sprintf(debugMsg, "SPI_Write: Sent 32-bit Data Chunk[%d]=0x%02X", 3 - i, dataChunk);
103:                           printf("%s\n", debugMsg);
104:                       }
105:                   }
106:               }
107:               else
108:               {
109:                   uint8_t dataHigh = (data >> 8) & 0xFF;
110:                   uint8_t dataLow = data & 0xFF;
111:                   SERCOM0_SPI_Write(&dataHigh, 1);
112:                   SERCOM0_SPI_Write(&dataLow, 1);
113:                   if (DEBUG)
114:                   {
115:                       sprintf(debugMsg, "SPI_Write: Sent 16-bit Data (High=0x%02X, Low=0x%02X)", dataHigh, dataLow);
116:                       printf("%s\n", debugMsg);
117:                   }
118:               }
119:               SPI_CSS_Control(css_pin, true);
120:               if (DEBUG)
121:               {
122:                   sprintf(debugMsg, "SPI_Write: CSS Pin=%d set to HIGH", css_pin);
123:                   printf("%s\n", debugMsg);
124:               }
125:           }
126:           
127:           uint32_t SPI_Read(uint32_t address, bool is32Bit, SPI_CSS_Pin css_pin)
128:           {
129:               uint32_t data = 0;
130:               uint8_t txBuf[2];
131:               uint8_t rxBuf[4] = {0};
132:               char debugMsg[128];
133:           
134:               // ADE9000 SPI read: 0x01 + 24-bit address
135:               txBuf[0] = (address >> 4) & 0xFF;
136:               txBuf[1] = (address << 4) | 0x8; // read byte 0x8 added for write it should be 0x0
137:               // txBuf[2] = (address >> 8) & 0xFF;
138:               // txBuf[3] = address & 0xFF;
139:           
140:               if (DEBUG)
141:               {
142:                   sprintf(debugMsg, "SPI_Read: Addr=0x%06lX (is32Bit=%d)", (unsigned long)address, is32Bit);
143:                   printf("%s\n", debugMsg);
144:               }
145:           
146:               // Pull CS low
147:               SPI_CSS_Control(css_pin, false);
148:           
149:               // Send the 4-byte command
150:               SERCOM0_SPI_Write(txBuf, 2);
151:           
152:               // Now receive 2 or 4 bytes
153:               if (is32Bit)
154:               {
155:                   SERCOM0_SPI_Read(rxBuf, 4);
156:                   data = ((uint32_t)rxBuf[0] << 24) |
157:                          ((uint32_t)rxBuf[1] << 16) |
158:                          ((uint32_t)rxBuf[2] << 8) |
159:                          (uint32_t)rxBuf[3];
160:               }
161:               else
162:               {
163:                   SERCOM0_SPI_Read(rxBuf, 2);
164:                   data = ((uint32_t)rxBuf[0] << 8) | rxBuf[1];
165:               }
166:           
167:               // Pull CS high
168:               SPI_CSS_Control(css_pin, true);
169:           
170:               if (DEBUG)
171:               {
172:                   sprintf(debugMsg, "SPI_Read: Data=0x%08lX", (unsigned long)data);
173:                   printf("%s\n", debugMsg);
174:               }
175:           
176:               return data;
177:           }
